---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Section from "~/components/Section.astro";
import Approach from "~/components/Approach.astro";
import CTA from "~/components/CTA.astro";

const beliefs = [
  {
    title: "Code is the deliverable.",
    body:
      "Slide decks and roadmaps don't run in production. We earn our keep by writing, shipping, and operating software — and by making the decisions that prevent it from rotting.",
  },
  {
    title: "Architecture is a sequence of trade-offs.",
    body:
      "There is no universally correct stack, pattern, or framework. Good architecture is the one that fits the constraints in front of you — and leaves you the most room to be wrong.",
  },
  {
    title: "Strong types, strong contracts.",
    body:
      "Across frontends, APIs, and data layers. End-to-end typing eliminates whole categories of defects and makes change tractable later.",
  },
  {
    title: "Small surfaces, clear seams.",
    body:
      "We build with sharp boundaries between components, services, and teams. Small surfaces are easier to reason about, replace, and evolve.",
  },
  {
    title: "Performance is a feature.",
    body:
      "Speed, accessibility, and reliability are product attributes, not afterthoughts. We treat them as constraints, not aspirations.",
  },
  {
    title: "AI is a capability, not a strategy.",
    body:
      "We've shipped real AI features. We use them where they earn their keep and rule them out where they don't. Hype is not a load-bearing material.",
  },
];

const engagementShapes = [
  {
    title: "Fixed-scope build",
    duration: "6 – 16 weeks",
    body: "A defined product or platform delivered end-to-end against an agreed brief.",
  },
  {
    title: "Diagnostic & remediation",
    duration: "2 – 8 weeks",
    body: "Architecture review, prioritised plan, and implementation of the highest-leverage changes.",
  },
  {
    title: "Embedded engineering",
    duration: "3 – 6 months",
    body: "Fractional staff-level engineer inside your team, on a rolling term.",
  },
  {
    title: "Advisory & coaching",
    duration: "Ad hoc",
    body: "Short-form architecture review, hiring support, or technical sounding board.",
  },
];
---

<BaseLayout
  title="Approach — Noramo Deb"
  description="How Noramo Deb works: pragmatic, senior, hands-on. Built around outcomes, not output."
>
  <Section
    eyebrow="Approach"
    title="Senior engineering, applied with judgement."
    description="We work the way good in-house teams work — only smaller, faster, and unencumbered. Here's what guides us."
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        beliefs.map((b, i) => (
          <article class="card">
            <div class="step-num">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="mt-3 text-xl font-semibold tracking-tight">{b.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-fg-muted)]">{b.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Approach />

  <Section
    eyebrow="Engagement shapes"
    title="Ways to work together."
    description="Every engagement starts the same way: a short conversation about what good looks like."
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        engagementShapes.map((e) => (
          <div class="card">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-medium tracking-tight">{e.title}</h3>
              <span class="text-xs font-[var(--font-mono)] tracking-wider uppercase text-[color:var(--color-fg-subtle)]">
                {e.duration}
              </span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-fg-muted)]">{e.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <CTA />
</BaseLayout>
