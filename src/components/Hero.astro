---
// Hero — primary positioning. Restrained, typographic, premium.
---

<section class="relative overflow-hidden">
  <!-- Background grid -->
  <div class="absolute inset-0 grid-bg pointer-events-none" aria-hidden="true"></div>
  <!-- Soft top glow -->
  <div
    class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1100px] h-[600px] pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(closest-side, rgba(255,255,255,0.08), transparent 70%);"
  ></div>

  <div class="container-page relative pt-20 md:pt-28 pb-20 md:pb-28">
    <div class="reveal">
      <span class="eyebrow">Noramo Deb · Est. London</span>
    </div>

    <h1
      class="reveal reveal-delay-1 mt-6 max-w-[20ch] font-semibold"
      style="font-size: clamp(2.5rem, 6vw, var(--text-display)); line-height: var(--text-display--line-height); letter-spacing: var(--text-display--letter-spacing);"
    >
      Engineering and product consultancy for ambitious teams.
    </h1>

    <p
      class="reveal reveal-delay-2 mt-7 max-w-[60ch] text-lg md:text-xl text-[color:var(--color-fg-muted)]"
    >
      We partner with founders, product teams, and enterprises to design, build,
      and scale modern software — from architecture and platform decisions to
      production delivery. Senior engineering, applied with judgement.
    </p>

    <div class="reveal reveal-delay-3 mt-10 flex flex-wrap items-center gap-3">
      <a href="/contact" class="btn btn-primary">
        Start a project
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="#services" class="btn btn-ghost">See what we do</a>
      <span class="pill ml-2"><span class="dot"></span>Currently accepting Q3 engagements</span>
    </div>

    <!-- Spec strip -->
    <div class="reveal reveal-delay-4 mt-20 grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-8 border-t border-[color:var(--color-border)] pt-10">
      <div>
        <div class="mono-caption">Experience</div>
        <div class="mt-2 text-2xl font-semibold tracking-tight">15+ yrs</div>
        <div class="text-sm text-[color:var(--color-fg-muted)] mt-1">senior engineering</div>
      </div>
      <div>
        <div class="mono-caption">Sectors</div>
        <div class="mt-2 text-2xl font-semibold tracking-tight">7+</div>
        <div class="text-sm text-[color:var(--color-fg-muted)] mt-1">gov, finance, media, aviation, retail</div>
      </div>
      <div>
        <div class="mono-caption">Engagements</div>
        <div class="mt-2 text-2xl font-semibold tracking-tight">40+</div>
        <div class="text-sm text-[color:var(--color-fg-muted)] mt-1">delivered across UK &amp; EMEA</div>
      </div>
      <div>
        <div class="mono-caption">Stack</div>
        <div class="mt-2 text-2xl font-semibold tracking-tight">Modern</div>
        <div class="text-sm text-[color:var(--color-fg-muted)] mt-1">TypeScript · React · Node · AI</div>
      </div>
    </div>
  </div>
</section>
