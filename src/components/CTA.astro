---
// Closing call-to-action band
---

<section class="relative">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-3xl border border-[color:var(--color-border-strong)] bg-gradient-to-b from-white/[0.04] to-white/[0.01] p-10 md:p-16">
      <div
        class="absolute inset-0 pointer-events-none opacity-60"
        aria-hidden="true"
        style="background: radial-gradient(700px 320px at 20% 0%, rgba(255,255,255,0.10), transparent 60%), radial-gradient(600px 280px at 90% 100%, rgba(255,255,255,0.06), transparent 60%);"
      ></div>

      <div class="relative">
        <span class="eyebrow">Engagements</span>
        <h2
          class="mt-5 max-w-3xl font-semibold"
          style="font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.05; letter-spacing: -0.03em;"
        >
          Have a system to build, scale, or untangle? Let's talk.
        </h2>
        <p class="mt-6 max-w-2xl text-[color:var(--color-fg-muted)] text-lg">
          We respond to every enquiry within one working day. Initial conversations are short, candid, and free of charge.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="/contact" class="btn btn-primary">
            Start a project
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7H11M11 7L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="mailto:hello@noramodeb.com" class="btn btn-ghost">
            hello@noramodeb.com
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
