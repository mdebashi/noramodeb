---
import Section from "./Section.astro";
---

<Section
  id="principal"
  eyebrow="The principal"
  title="Mohammed Debashi"
  description="Founder and principal engineer. Fifteen years building software that organisations rely on — from public-sector platforms to consumer streaming products to AI-native tools."
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
    <div class="md:col-span-7">
      <div class="card">
        <div class="prose prose-invert max-w-none">
          <p class="text-[15px] leading-relaxed text-[color:var(--color-fg)]">
            Senior software engineer and product builder. Specialises in modern
            JavaScript and TypeScript ecosystems, full-stack delivery, and
            applied AI. Has led frontend architecture and full-stack delivery
            across UK government, defence, aviation, broadcast, retail, and
            financial services.
          </p>
          <p class="text-[15px] leading-relaxed mt-4 text-[color:var(--color-fg-muted)]">
            Most recently, founded
            <span class="text-[color:var(--color-fg)]">Lintel</span> — an AI
            renovation decision-support platform built on multi-agent
            workflows — and operated as a senior engineer on
            <span class="text-[color:var(--color-fg)]">R2D2</span>, a
            data-driven readiness and risk platform for UK Defence services.
          </p>
        </div>

        <div class="mt-7 grid grid-cols-2 gap-4">
          <div>
            <div class="mono-caption">Based</div>
            <div class="mt-1 text-sm">London, United Kingdom</div>
          </div>
          <div>
            <div class="mono-caption">Education</div>
            <div class="mt-1 text-sm">MSc, BSc — Brunel University</div>
          </div>
          <div>
            <div class="mono-caption">Specialisms</div>
            <div class="mt-1 text-sm">Full-stack · Architecture · AI</div>
          </div>
          <div>
            <div class="mono-caption">Standards</div>
            <div class="mt-1 text-sm">WCAG · GDS · Performance-first</div>
          </div>
        </div>
      </div>
    </div>

    <div class="md:col-span-5 space-y-5">
      <div class="card">
        <div class="mono-caption">Selected experience</div>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex items-start justify-between gap-4">
            <span class="text-[color:var(--color-fg)]">Founder & Lead Engineer</span>
            <span class="text-[color:var(--color-fg-muted)] text-xs whitespace-nowrap">Lintel · 2026 –</span>
          </li>
          <li class="flex items-start justify-between gap-4">
            <span class="text-[color:var(--color-fg)]">Senior Engineer</span>
            <span class="text-[color:var(--color-fg-muted)] text-xs whitespace-nowrap">UK Central Government · 2023 – 2026</span>
          </li>
          <li class="flex items-start justify-between gap-4">
            <span class="text-[color:var(--color-fg)]">Senior Web Developer</span>
            <span class="text-[color:var(--color-fg-muted)] text-xs whitespace-nowrap">DEFRA · 2025 – 2026</span>
          </li>
          <li class="flex items-start justify-between gap-4">
            <span class="text-[color:var(--color-fg)]">UI Consultant</span>
            <span class="text-[color:var(--color-fg-muted)] text-xs whitespace-nowrap">Emirates Airline · 2022</span>
          </li>
          <li class="flex items-start justify-between gap-4">
            <span class="text-[color:var(--color-fg)]">Lead UI / Senior Web Developer</span>
            <span class="text-[color:var(--color-fg-muted)] text-xs whitespace-nowrap">Met Office · 2020 – 2022</span>
          </li>
          <li class="flex items-start justify-between gap-4">
            <span class="text-[color:var(--color-fg)]">Lead Web Developer</span>
            <span class="text-[color:var(--color-fg-muted)] text-xs whitespace-nowrap">My5 (UI Centric) · 2019 – 2020</span>
          </li>
        </ul>
      </div>

      <div class="card">
        <div class="flex items-center justify-between">
          <div>
            <div class="mono-caption">Get in touch</div>
            <div class="mt-1 text-sm">Direct line to the principal</div>
          </div>
          <a href="/contact" class="btn btn-ghost text-sm">Contact</a>
        </div>
      </div>
    </div>
  </div>
</Section>
