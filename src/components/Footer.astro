---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-border)] mt-32">
  <div class="container-page py-14">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <Logo />
        <p class="mt-4 max-w-sm text-sm text-[color:var(--color-fg-muted)] leading-relaxed">
          A modern engineering and product consultancy. We help teams architect,
          build, and ship scalable software — pragmatically and at pace.
        </p>
        <div class="mt-6 flex items-center gap-2">
          <span class="pill"><span class="dot"></span>Available for new engagements</span>
        </div>
      </div>

      <div class="md:col-span-2">
        <div class="mono-caption mb-3">Company</div>
        <ul class="space-y-2 text-sm">
          <li><a class="text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)] transition-colors" href="/services">Services</a></li>
          <li><a class="text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)] transition-colors" href="/approach">Approach</a></li>
          <li><a class="text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)] transition-colors" href="/#principal">About</a></li>
          <li><a class="text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)] transition-colors" href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <div class="mono-caption mb-3">Capabilities</div>
        <ul class="space-y-2 text-sm">
          <li class="text-[color:var(--color-fg-muted)]">Product engineering</li>
          <li class="text-[color:var(--color-fg-muted)]">Platform &amp; architecture</li>
          <li class="text-[color:var(--color-fg-muted)]">AI integration</li>
          <li class="text-[color:var(--color-fg-muted)]">Technical leadership</li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <div class="mono-caption mb-3">Contact</div>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              class="text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)] transition-colors"
              href="mailto:hello@noramodeb.com"
            >hello@noramodeb.com</a>
          </li>
          <li class="text-[color:var(--color-fg-muted)]">London, United Kingdom</li>
          <li>
            <a
              class="text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)] transition-colors"
              href="https://linkedin.com/in/debashi"
              target="_blank"
              rel="noreferrer noopener"
            >LinkedIn</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="hairline mt-12"></div>
    <div class="mt-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-xs text-[color:var(--color-fg-subtle)]">
      <div>© {year} Noramo Deb Limited. Registered in England &amp; Wales.</div>
      <div class="font-[var(--font-mono)] tracking-wider uppercase">v1.0 · built with care</div>
    </div>
  </div>
</footer>
